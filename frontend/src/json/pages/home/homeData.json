"comp2": {
  "title": "About The GNSS Research Lab",
  "description1": "The Global Navigation Satellite System (GNSS) Research Lab is a premier academic and research facility operating under the umbrella of the National Center of GIS and Space Applications (NCGSA). Our lab is dedicated to advancing the science, engineering, and practical applications of satellite-based positioning, navigation, and timing (PNT) technologies.",
  "description2": "By bridging the gap between theoretical space sciences and terrestrial engineering, we develop cutting-edge solutions that drive national progress in autonomous navigation, geospatial infrastructure, and atmospheric monitoring.",
  "linkText": "LEARN MORE ABOUT US",
  "link": "/about",
  "image": "https://apiweb.ist.edu.pk/media/original_images/01.jpg"
},
